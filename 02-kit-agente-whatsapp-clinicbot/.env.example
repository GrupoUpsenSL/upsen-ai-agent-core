# ============================================================
# Variables de entorno del agente de WhatsApp
# Copia este archivo a .env.local y rellena los valores.
# El comando /setup lo hace por ti. Nunca subas .env.local a Git.
# ============================================================

# --- OBLIGATORIO ---

# API key de OpenRouter (https://openrouter.ai)
# El agente la usa para hablar con el modelo de IA que elijas.
# La cuenta y la key son gratuitas; el saldo lo cargas tú: unos 5 € (pago único,
# en openrouter.ai/credits) dan para meses de uso normal. Sin saldo, el agente
# no responde (error 402).
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Modelo de IA que usará el agente.
# Recomendado (buen español, prompt largo, tool calling): anthropic/claude-haiku-4.5
# Alternativa más barata a gran volumen: openai/gpt-4o-mini
# NO uses modelos ":free": se saturan y dan errores 429 en producción.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- CRM de leads · Airtable (OPCIONAL) ---
# Si lo rellenas, el agente guarda cada lead (nombre, email, notas) en tu Airtable.
# Si lo dejas vacío, el agente funciona igual pero sin CRM.
# Token: https://airtable.com/create/tokens (scopes: data.records:read + write)
# Los IDs (base, tabla, UTM) los ves en la URL/API de tu base de Airtable.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_LEADS_TABLE=tblXXXXXXXXXXXXXX
# Record de una UTM para la atribución (opcional; déjalo si no lo usas)
AIRTABLE_AGENT_UTM=recXXXXXXXXXXXXXX

# --- Memoria de largo plazo · Supabase (OPCIONAL pero recomendado) ---
# Si se rellenan, el agente RECUERDA a cada persona entre conversaciones: aunque
# vuelva a escribir dentro de meses, la reconoce por su teléfono y retoma lo
# hablado. Vacío = el agente funciona igual, pero sin memoria larga.
# 1) Crea un proyecto gratis en https://supabase.com
# 2) En el SQL Editor pega el script de docs/08-memoria-supabase.md (crea las tablas)
# 3) Project Settings > API: copia la Project URL y la clave service_role (secreta)
# La service_role da acceso total a la base: trátala como una contraseña.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Transcripción de notas de voz (OPCIONAL) ---
# Usa tu MISMO OPENROUTER_API_KEY: no necesitas otra cuenta. El audio se pasa a
# un modelo multimodal que lo transcribe. Por defecto google/gemini-2.5-flash.
TRANSCRIPTION_MODEL=google/gemini-2.5-flash

# --- Interpretar imágenes que envían los leads (OPCIONAL) ---
# El agente "ve" las fotos/capturas que le mandan y responde. Misma key de
# OpenRouter, modelo multimodal. Por defecto gemini flash (barato).
VISION_MODEL=google/gemini-2.5-flash

# --- Agrupación de mensajes ---
# Segundos que espera el bot por si el lead sigue escribiendo, para responder a
# todo junto como una sola conversación (por defecto 10).
BUFFER_SECONDS=10

# --- Guardrails de seguridad (OPCIONAL, muy recomendado) ---
# Capa que impide que el agente invente precios o mande enlaces raros.
# /personaliza las rellena a partir de tu negocio.md. Vacío = guardrail permisivo.
#
# Precios que el agente PUEDE decir (los de tu negocio), separados por comas.
# OJO: incluye también las cifras DERIVADAS que quieras que pueda mencionar —
# el equivalente mensual de un plan anual, un pago fraccionado, un descuento.
# Ej: si vendes a 497 al año y quieres que diga "sale a unos 41 al mes",
# pon las dos: ALLOWED_PRICES=77,497,41
# Cualquier cifra de dinero que NO esté en esta lista bloquea la respuesta
# (el lead recibe el mensaje neutro de GUARD_FALLBACK_MSG en su lugar).
ALLOWED_PRICES=
# Dominios que el agente PUEDE enlazar (los tuyos), separados por comas.
# wa.me se permite siempre. Ej: tuweb.com,tienda.tuweb.com
ALLOWED_HOSTS=
# Tu enlace de compra/reserva (para la métrica de "enlaces enviados"). Opcional.
CHECKOUT_URL=
# Código interno "canario": una cadena única y secreta. Si aparece en una
# respuesta, se bloquea (el modelo estaría filtrando su prompt). /setup te
# genera uno aleatorio; ponlo también al final de prompts/negocio.md.
SECURITY_CANARY=
# Mensaje que se envía al lead cuando los guardrails bloquean una respuesta.
# Vacío = se usa el mensaje neutro por defecto del kit.
GUARD_FALLBACK_MSG=

# --- Agendado de llamadas (OPCIONAL, desactivado de serie) ---
# Enlace de Cal.com/Calendly que usaría la herramienta `agendar`
# (src/lib/tools/agendar.ts). Esa herramienta NO viene activada: el agente de
# serie cierra por chat. Tu enlace de reserva normal ponlo en la sección de
# Enlaces de prompts/negocio.md (y en ALLOWED_HOSTS). Solo rellena esto si
# registras `agendar` en src/lib/tools/index.ts.
CAL_BOOKING_URL=

# --- Watchdog · autovigilancia con avisos por WhatsApp (OPCIONAL) ---
# Número (con prefijo de país, solo dígitos) al que el agente te avisa si algo va
# mal (se queda mudo, se acaba el saldo) y al que manda el parte diario. Suele
# ser TU móvil personal, distinto del número del agente. Vacío = solo registra
# en el log, no envía avisos. Ej: 34600112233
ALERT_WHATSAPP=

# --- OPCIONAL · Producción ---

# Puerto del dashboard (por defecto 3000)
PORT=3000

# Nivel de log del bot: silent | error | warn | info | debug
LOG_LEVEL=info
